{
  "name": "aipet-agents",
  "main": "src/agents/worker.ts",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Durable Objects 配置
  "durable_objects": {
    "bindings": [
      {
        "name": "ProjectManagerAgent",
        "class_name": "ProjectManagerAgent"
      },
      {
        "name": "FrontendAgent",
        "class_name": "FrontendAgent"
      },
      {
        "name": "BackendAgent",
        "class_name": "BackendAgent"
      },
      {
        "name": "TestAgent",
        "class_name": "TestAgent"
      },
      {
        "name": "DeployAgent",
        "class_name": "DeployAgent"
      }
    ]
  },

  // 迁移配置
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ProjectManagerAgent",
        "FrontendAgent",
        "BackendAgent",
        "TestAgent",
        "DeployAgent"
      ]
    }
  ],

  // AI 绑定（用于 Workers AI）
  "ai": {
    "binding": "AI"
  },

  // 环境变量
  "vars": {
    "ENVIRONMENT": "development"
  },

  // 路由配置（可选）
  "routes": [
    {
      "pattern": "agents.your-domain.com",
      "zone_name": "your-domain.com"
    }
  ],

  // 构建配置
  "build": {
    "command": "npm run build:agents"
  },

  // 触发器（定时任务）
  "triggers": {
    "crons": ["0 * * * *"] // 每小时运行一次
  }
}
