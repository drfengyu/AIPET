# AIPET 内存优化配置

# ============================================
# 调试和日志配置
# ============================================

# 启用详细日志和诊断
# 设置为 true 时：
#   - 启用 debugLog 和 phaseLog 输出
#   - 启用 DevTools（开发环境）
#   - 启用诊断定时器
#   - 启用内存监控
# 默认：false（生产环境推荐）
DEBUG=false

# ============================================
# GPU 加速配置
# ============================================

# 禁用 GPU 加速
# 设置为 true 时：
#   - 禁用 GPU 加速
#   - 使用软件光栅化
#   - 适用于 GPU 驱动有问题的系统
# 默认：false（启用 GPU 加速）
DISABLE_GPU=false

# ============================================
# 应用环境
# ============================================

NODE_ENV=production

# Cloudflare Workers AI 配置
VITE_CLOUDFLARE_ACCOUNT_ID=your_account_id
VITE_CLOUDFLARE_API_TOKEN=your_api_token
